{
  "name": "fringe-favourites",
  "version": "0.1.0",
  "homepage": "https://richardl62.github.io/fringe-favourites",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "styled-components": "^6.4.4",
    "yaml": "^2.9.0"
  },
  "scripts": {
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "start": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "type-check": "tsc -b --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fetch-dates": "node scripts/fetch-dates.ts",
    "fetch-dates:quick": "node scripts/fetch-dates.ts --quick",
    "fetch-free-fringe": "node scripts/fetch-free-fringe.ts",
    "fetch-free-fringe:quick": "node scripts/fetch-free-fringe.ts --quick",
    "fetch-scotsman-reviews": "node scripts/fetch-scotsman-reviews.ts",
    "tidy-shows": "node scripts/tidy-shows.ts",
    "update-shows:quick": "npm run fetch-dates:quick && npm run fetch-free-fringe:quick && npm run tidy-shows",
    "update-shows": "npm run fetch-scotsman-reviews; npm run fetch-dates && npm run fetch-free-fringe && npm run tidy-shows",
    "format": "prettier --write .",
    "validate": "npm run type-check && npm run lint && npm run test"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "gh-pages": "^6.3.0",
    "globals": "^17.8.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "volta": {
    "node": "22.23.2"
  }
}
